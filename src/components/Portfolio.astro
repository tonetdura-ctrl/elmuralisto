---
import { Picture, getImage } from 'astro:assets';
import { murals } from '../data/site';

const filters = ['Todos', 'Comercios', 'Hogar'];
const large = await Promise.all(
  murals.map((m) => getImage({ src: m.image, width: 1448, format: 'webp' })),
);
---

<section id="obras" class="py-24 sm:py-32">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="eyebrow">Portfolio</span>
        <h2 class="mt-5 text-4xl leading-tight font-medium sm:text-6xl">
          Obras que transforman <em class="text-terracotta italic">espacios</em>
        </h2>
      </div>
      <div class="flex gap-2" role="group" aria-label="Filtrar obras">
        {
          filters.map((f, i) => (
            <button
              type="button"
              data-filter={f}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold transition aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-cream hover:border-ink"
            >
              {f}
            </button>
          ))
        }
      </div>
    </div>

    <ul id="grid" class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {
        murals.map((m, i) => {
          // patrón editorial: tarjetas grandes y pequeñas alternadas
          const span = i === 0 ? 'lg:col-span-4' : 'lg:col-span-2';
          return (
            <li data-category={m.category} class={`reveal ${span}`}>
              <button
                type="button"
                class="group relative block h-full w-full overflow-hidden rounded-3xl bg-sand text-left"
                data-open={i}
                aria-label={`Ampliar mural ${m.title}`}
              >
                <Picture
                  src={m.image}
                  formats={['avif', 'webp']}
          fallbackFormat="jpg"
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 60vw, (min-width: 640px) 50vw, 100vw"
                  alt={`${m.title}: mural para ${m.place.toLowerCase()}`}
                  class="aspect-[4/3] size-full object-cover transition duration-700 ease-out-expo group-hover:scale-105 lg:h-full lg:min-h-[22rem]"
                  transition:name={`mural-${m.slug}`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/0 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-100" />
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 text-cream">
                  <div>
                    <p class="text-xs font-semibold tracking-[0.2em] uppercase opacity-80">
                      {m.category} · {m.place}
                    </p>
                    <h3 class="mt-1.5 font-display text-2xl font-medium sm:text-3xl">{m.title}</h3>
                  </div>
                  <span class="grid size-11 shrink-0 translate-y-2 place-items-center rounded-full bg-cream text-ink opacity-0 transition duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>

  <dialog
    id="lightbox"
    class="lightbox m-auto w-[min(72rem,calc(100%-2rem))] max-h-[calc(100dvh-2rem)] overflow-auto rounded-[2rem] bg-paper p-0 text-ink shadow-2xl"
    aria-labelledby="lb-title"
  >
    <div class="grid lg:grid-cols-[1.6fr_1fr]">
      <div class="relative bg-sand">
        <img id="lb-img" src="" alt="" class="aspect-[4/3] size-full object-cover" />
        <div class="absolute inset-x-4 bottom-4 flex justify-between">
          <button type="button" data-step="-1" class="grid size-11 place-items-center rounded-full bg-cream/90 shadow backdrop-blur hover:bg-cream" aria-label="Anterior">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
          <button type="button" data-step="1" class="grid size-11 place-items-center rounded-full bg-cream/90 shadow backdrop-blur hover:bg-cream" aria-label="Siguiente">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
        </div>
      </div>
      <div class="flex flex-col p-8 sm:p-10">
        <div class="flex items-start justify-between gap-4">
          <p id="lb-cat" class="eyebrow"></p>
          <form method="dialog">
            <button class="-mt-2 -mr-2 grid size-10 place-items-center rounded-full hover:bg-ink/5" aria-label="Cerrar">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path></svg>
            </button>
          </form>
        </div>
        <h3 id="lb-title" class="mt-4 text-4xl font-medium"></h3>
        <p id="lb-desc" class="mt-4 leading-relaxed text-ink-soft"></p>
        <p class="mt-8 text-xs font-semibold tracking-[0.2em] text-ink-soft uppercase">Paleta</p>
        <div id="lb-palette" class="mt-3 flex gap-2"></div>
        <a id="lb-cta" href="#contacto" class="btn-accent mt-10 w-full">Quiero un mural así</a>
      </div>
    </div>
  </dialog>

  <script
    is:inline
    type="application/json"
    id="murals-data"
    set:html={JSON.stringify(
      murals.map((m, i) => ({
        title: m.title,
        category: `${m.category} · ${m.place}`,
        description: m.description,
        palette: m.palette,
        src: large[i].src,
        alt: `${m.title}: mural para ${m.place.toLowerCase()}`,
      })),
    )}
  />
</section>

<style>
  @media (min-width: 1024px) {
    #grid[data-filtered] > li {
      grid-column: span 3 / span 3;
    }
  }
</style>

<script>
  function initPortfolio() {
    const grid = document.getElementById('grid');
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const dataEl = document.getElementById('murals-data');
    if (!grid || !dialog || !dataEl) return;

    const data: {
      title: string;
      category: string;
      description: string;
      palette: string[];
      src: string;
      alt: string;
    }[] = JSON.parse(dataEl.textContent || '[]');

    // Filtros con View Transitions API cuando está disponible
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        const apply = () => {
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          if (f === 'Todos') delete grid.dataset.filtered;
          else grid.dataset.filtered = 'true';
          grid.querySelectorAll<HTMLElement>('li').forEach((li) => {
            li.hidden = f !== 'Todos' && li.dataset.category !== f;
          });
        };
        document.startViewTransition ? document.startViewTransition(apply) : apply();
      }),
    );

    // Lightbox accesible con <dialog>
    let current = 0;
    const img = dialog.querySelector<HTMLImageElement>('#lb-img')!;
    const show = (i: number) => {
      current = (i + data.length) % data.length;
      const m = data[current];
      img.src = m.src;
      img.alt = m.alt;
      dialog.querySelector('#lb-title')!.textContent = m.title;
      dialog.querySelector('#lb-cat')!.textContent = m.category;
      dialog.querySelector('#lb-desc')!.textContent = m.description;
      dialog.querySelector('#lb-palette')!.innerHTML = m.palette
        .map((c) => `<span class="size-10 rounded-full ring-1 ring-ink/10" style="background:${c}" title="${c}"></span>`)
        .join('');
      const cta = dialog.querySelector<HTMLAnchorElement>('#lb-cta')!;
      cta.href = `#contacto`;
      cta.dataset.ref = m.title;
    };

    grid.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        show(Number(b.dataset.open));
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(current + Number(b.dataset.step))),
    );
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelector<HTMLAnchorElement>('#lb-cta')!.addEventListener('click', (e) => {
      const ref = (e.currentTarget as HTMLElement).dataset.ref;
      dialog.close();
      const msg = document.querySelector<HTMLTextAreaElement>('#mensaje');
      if (msg && ref && !msg.value) msg.value = `Hola, me encanta el mural «${ref}». Me gustaría algo en ese estilo para…`;
    });
  }
  document.addEventListener('astro:page-load', initPortfolio);
</script>
