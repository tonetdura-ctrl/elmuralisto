---
const links = [
  { href: '/#obras', label: 'Obras' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#presupuesto', label: 'Presupuesto' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header
  id="site-header"
  transition:persist
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 data-[scrolled=true]:bg-cream/80 data-[scrolled=true]:shadow-[0_1px_0_rgb(30_27_24/0.08)] data-[scrolled=true]:backdrop-blur-xl"
>
  <nav class="container-x flex h-18 items-center justify-between gap-6" aria-label="Principal">
    <a href="/" class="group flex items-center gap-2.5" aria-label="El Muralisto, inicio">
      <span
        class="grid size-9 place-items-center rounded-xl bg-terracotta text-cream transition-transform duration-500 group-hover:rotate-[-8deg]"
      >
        <svg viewBox="0 0 64 64" class="size-5" aria-hidden="true"
          ><path
            d="M14 48V18l18 16 18-16v30"
            fill="none"
            stroke="currentColor"
            stroke-width="7"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </span>
      <span class="font-display text-xl font-semibold tracking-tight">El Muralisto</span>
    </a>

    <ul class="hidden items-center gap-8 text-sm font-medium lg:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="relative py-2 text-ink-soft transition-colors hover:text-ink after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-terracotta after:transition-transform after:duration-500 hover:after:scale-x-100"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href="/#contacto" class="btn-primary hidden !py-2.5 sm:inline-flex">Pide tu mural</a>
      <button
        id="menu-btn"
        type="button"
        class="grid size-11 place-items-center rounded-full border border-ink/15 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="M4 8h16M4 16h16" stroke-linecap="round"></path></svg
        >
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-ink/10 bg-cream lg:hidden">
    <ul class="container-x flex flex-col py-4">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block py-3 font-display text-2xl">
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="pt-4"><a href="/#contacto" class="btn-accent w-full">Pide tu mural</a></li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  const onScroll = () => (header.dataset.scrolled = String(window.scrollY > 24));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    header.dataset.scrolled = open ? 'true' : String(window.scrollY > 24);
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('astro:after-swap', () => setOpen(false));
</script>
