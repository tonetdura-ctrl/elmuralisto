---
import { plans } from '../data/site';
const hogar = Number(plans[0].price);
const comercio = Number(plans[1].price);
const MINIMO = 450; // ⚠️ pedido mínimo orientativo en €
---

<section id="presupuesto" class="py-24 sm:py-32">
  <div class="container-x">
    <div class="overflow-hidden rounded-[2.5rem] bg-sand/60 ring-1 ring-ink/5">
      <div class="grid lg:grid-cols-[1.15fr_1fr]">
        <form id="calc" class="p-8 sm:p-12 lg:p-16" data-hogar={hogar} data-comercio={comercio} data-min={MINIMO}>
          <span class="eyebrow">Presupuesto al instante</span>
          <h2 class="mt-5 text-4xl leading-tight font-medium sm:text-5xl">¿Cuánto costaría tu mural?</h2>
          <p class="mt-4 max-w-md text-ink-soft">Ajusta las medidas y el estilo para obtener una estimación orientativa en segundos.</p>

          <fieldset class="mt-10">
            <legend class="label">Tipo de espacio</legend>
            <div class="grid grid-cols-2 gap-3">
              {
                [
                  ['hogar', 'Hogar', 'Salón, dormitorio…'],
                  ['comercio', 'Comercio', 'Tienda, restaurante…'],
                ].map(([v, t, d], i) => (
                  <label class="cursor-pointer rounded-2xl border border-ink/10 bg-paper p-4 transition has-checked:border-terracotta has-checked:ring-4 has-checked:ring-terracotta/15">
                    <input type="radio" name="tipo" value={v} checked={i === 0} class="sr-only" />
                    <span class="block font-semibold">{t}</span>
                    <span class="block text-sm text-ink-soft">{d}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="mt-8 grid grid-cols-2 gap-6">
            <div>
              <label for="ancho" class="label">Ancho <span class="font-normal text-ink-soft">(m)</span></label>
              <input id="ancho" name="ancho" type="number" inputmode="decimal" min="1" max="50" step="0.1" value="4" class="field" />
            </div>
            <div>
              <label for="alto" class="label">Alto <span class="font-normal text-ink-soft">(m)</span></label>
              <input id="alto" name="alto" type="number" inputmode="decimal" min="1" max="20" step="0.1" value="2.6" class="field" />
            </div>
          </div>

          <fieldset class="mt-8">
            <legend class="label">Nivel de detalle</legend>
            <div class="grid grid-cols-3 gap-3">
              {
                [
                  ['0.85', 'Sencillo'],
                  ['1', 'Medio'],
                  ['1.3', 'Detallado'],
                ].map(([v, t], i) => (
                  <label class="cursor-pointer rounded-full border border-ink/10 bg-paper px-3 py-3 text-center text-sm font-semibold transition has-checked:border-ink has-checked:bg-ink has-checked:text-cream">
                    <input type="radio" name="detalle" value={v} checked={i === 1} class="sr-only" />
                    {t}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class="mt-8 flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-ink/10 bg-paper p-4">
            <span>
              <span class="block font-semibold">Pared exterior / fachada</span>
              <span class="block text-sm text-ink-soft">Pinturas y barniz específicos para exterior</span>
            </span>
            <input type="checkbox" name="exterior" class="peer sr-only" />
            <span class="relative h-7 w-12 shrink-0 rounded-full bg-ink/15 transition peer-checked:bg-terracotta after:absolute after:top-1 after:left-1 after:size-5 after:rounded-full after:bg-paper after:shadow after:transition peer-checked:after:translate-x-5 peer-focus-visible:ring-4 peer-focus-visible:ring-terracotta/25"></span>
          </label>
        </form>

        <div class="relative flex flex-col justify-between bg-terracotta p-8 text-cream sm:p-12 lg:p-16">
          <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 size-72 rounded-full bg-mustard/30 blur-2xl"></div>
          <div class="relative">
            <p class="text-sm font-semibold tracking-[0.2em] uppercase opacity-80">Estimación</p>
            <p class="mt-6 font-display text-[clamp(2.25rem,4.4vw,3.75rem)] leading-none font-medium" aria-live="polite">
              <span id="out-range">—</span>
            </p>
            <p class="mt-3 text-cream/80">IVA no incluido</p>

            <dl class="mt-10 space-y-4 border-t border-cream/20 pt-8 text-sm">
              <div class="flex justify-between"><dt class="opacity-80">Superficie</dt><dd id="out-area" class="font-semibold">—</dd></div>
              <div class="flex justify-between"><dt class="opacity-80">Precio base</dt><dd id="out-base" class="font-semibold">—</dd></div>
              <div class="flex justify-between"><dt class="opacity-80">Incluye</dt><dd class="font-semibold">Diseño + boceto + barniz</dd></div>
            </dl>
          </div>
          <div class="relative mt-12">
            <a href="#contacto" id="calc-cta" class="btn w-full bg-cream text-ink hover:bg-ink hover:text-cream">
              Solicitar presupuesto cerrado
            </a>
            <p class="mt-4 text-center text-xs text-cream/75">Respuesta en menos de 48 h · Sin compromiso</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCalc() {
    const form = document.getElementById('calc') as HTMLFormElement | null;
    if (!form) return;
    const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const round = (n: number) => Math.round(n / 10) * 10;
    let summary = '';

    const update = () => {
      const fd = new FormData(form);
      const tipo = String(fd.get('tipo'));
      const base = Number(form.dataset[tipo as 'hogar' | 'comercio']);
      const min = Number(form.dataset.min);
      const w = Math.max(0, Number(fd.get('ancho')) || 0);
      const h = Math.max(0, Number(fd.get('alto')) || 0);
      const area = w * h;
      const factor = Number(fd.get('detalle')) * (fd.get('exterior') ? 1.15 : 1);
      const mid = Math.max(min, area * base * factor);
      const lo = round(mid * 0.9);
      const hi = round(mid * 1.1);

      document.getElementById('out-range')!.textContent = area > 0 ? `${eur.format(lo)} – ${eur.format(hi)}` : '—';
      document.getElementById('out-area')!.textContent = `${area.toLocaleString('es-ES', { maximumFractionDigits: 1 })} m²`;
      document.getElementById('out-base')!.textContent = `${base} €/m²`;

      const detalle = { '0.85': 'sencillo', '1': 'medio', '1.3': 'detallado' }[String(fd.get('detalle'))];
      summary = `${tipo === 'hogar' ? 'Hogar' : 'Comercio'} · ${w} × ${h} m (${area.toFixed(1)} m²) · detalle ${detalle}${
        fd.get('exterior') ? ' · exterior' : ''
      } · estimación ${eur.format(lo)}–${eur.format(hi)}`;
    };

    form.addEventListener('input', update);
    update();

    document.getElementById('calc-cta')?.addEventListener('click', () => {
      const hidden = document.querySelector<HTMLInputElement>('#estimacion');
      const tipoSel = document.querySelector<HTMLSelectElement>('#tipo-espacio');
      const m2 = document.querySelector<HTMLInputElement>('#metros');
      const note = document.querySelector<HTMLElement>('#estimacion-nota');
      const fd = new FormData(form);
      if (hidden) hidden.value = summary;
      if (tipoSel) tipoSel.value = String(fd.get('tipo'));
      if (m2) m2.value = (Number(fd.get('ancho')) * Number(fd.get('alto'))).toFixed(1);
      if (note) {
        note.textContent = summary;
        note.parentElement!.hidden = false;
      }
    });
  }
  document.addEventListener('astro:page-load', initCalc);
</script>
