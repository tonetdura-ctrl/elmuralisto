---
import { Picture } from 'astro:assets';
import { steps } from '../data/site';
import dormitorio from '../assets/murales/dormitorio-jardin.png';
---

<section id="proceso" class="py-24 sm:py-32">
  <div class="container-x grid gap-16 lg:grid-cols-2 lg:gap-24">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <span class="eyebrow">Cómo trabajo</span>
      <h2 class="mt-5 text-4xl leading-tight font-medium sm:text-6xl">
        De la idea a la pared, <em class="text-terracotta italic">sin complicaciones</em>
      </h2>
      <div class="mt-10 overflow-hidden rounded-[2rem] shadow-xl shadow-ink/10">
        <Picture
          src={dormitorio}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt="Mural floral en tonos lavanda y salvia detrás de una cama"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
    </div>

    <ol class="relative space-y-6">
      {
        steps.map((s, i) => (
          <li class="reveal group relative flex gap-6 rounded-[2rem] border border-ink/10 bg-paper p-8 transition hover:border-terracotta/40 hover:shadow-xl hover:shadow-ink/5 sm:p-10">
            <span class="font-display text-5xl leading-none font-light text-terracotta tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-2xl font-medium sm:text-3xl">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
