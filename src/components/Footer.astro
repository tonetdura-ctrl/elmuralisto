---
import { site } from '../data/site';
const year = new Date().getFullYear();
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola, me gustaría pedir presupuesto para un mural.')}`;
---

<footer class="bg-ink pb-10 text-cream">
  <div class="container-x">
    <p
      class="border-t border-cream/10 pt-16 font-display text-[clamp(3.5rem,14vw,12rem)] leading-[0.85] font-medium tracking-tight"
      aria-hidden="true"
    >
      El Muralisto<span class="text-terracotta">.</span>
    </p>
    <div class="mt-12 flex flex-col justify-between gap-6 text-sm text-cream/60 sm:flex-row sm:items-center">
      <p>© {year} {site.name}. Murales pintados a mano.</p>
      <ul class="flex flex-wrap gap-6">
        <li><a href="/#obras" class="hover:text-cream">Obras</a></li>
        <li><a href="/#servicios" class="hover:text-cream">Servicios</a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-cream">Instagram</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-cream">{site.email}</a></li>
      </ul>
    </div>
  </div>
</footer>

<a
  href={wa}
  target="_blank"
  rel="noopener"
  transition:persist
  class="fixed right-5 bottom-5 z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-ink shadow-xl shadow-ink/25 transition hover:scale-110"
  aria-label="Escríbeme por WhatsApp"
>
  <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true"
    ><path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .3-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l2.1 1c.3.1.5.2.6.3.1.2.1.8-.2 1.5Z"
    ></path></svg
  >
</a>
